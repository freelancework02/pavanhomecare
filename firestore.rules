rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Pavan Homecare Contact Form Inquiries
    match /PHC-Contact-form-inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 2. Pavan Homecare Chatbot Inquiries
    match /PHC-Chatbot-inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 3. Pavan Homecare Admin Credentials (Hashed passwords, server-authenticated)
    match /PHC-Admin-panel-pass/{id} {
      allow read, write: if true;
    }

    match /PHC-Admin-panel/{id} {
      allow read, write: if true;
    }

    // 4. Pavan Homecare Dynamic Blogs
    match /PHC-Blogs/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Pavan Homecare Cookie Consent & Telemetry Data (Privacy Compliant)
    match /PHC-cookie-consent-data/{id} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
